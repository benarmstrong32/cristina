# Long random string used to sign login sessions. Generate: openssl rand -base64 32
SESSION_SECRET=

# Who can log in. JSON array. Hash passwords with: npm run hash-password -- 'the-password'
DASHBOARD_USERS=[{"email":"you@9milesmedia.com","name":"Your name","role":"team","passwordHash":"scrypt$..."}]

# Optional. Meta Marketing API token with ads_read on the 9miles Media ad account (System User token recommended).
# Without it, ad numbers come from the saved copy in data/meta-saved.json.
META_ACCESS_TOKEN=
