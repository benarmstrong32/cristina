# Long random string used to sign login sessions. Generate: openssl rand -base64 32
SESSION_SECRET=

# Who can log in. JSON array. Hash passwords with: npm run hash-password -- 'the-password'
# role "team" sees every client + the team tab; role "client" sees only their clientId's client view.
DASHBOARD_USERS=[{"email":"you@agency.com","name":"Team","role":"team","passwordHash":"scrypt$..."},{"email":"owner@client.com","name":"Client","role":"client","clientId":"new-velocity","passwordHash":"scrypt$..."}]

# Meta Marketing API token with ads_read on the client's ad account (System User token recommended).
META_ACCESS_TOKEN=

# GoHighLevel Private Integration token for each client's sub-account.
# Scopes: contacts.readonly, opportunities.readonly, calendars.readonly, calendars/events.readonly
GHL_TOKEN_NEW_VELOCITY=

# Extra emails to treat as internal/test contacts (comma-separated).
EXCLUDE_EMAILS=
