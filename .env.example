# --- Meta Marketing API ---
# Create a System User in Business Settings > Users > System Users, assign it every
# ad account (yours + clients' accounts shared to your Business Manager), and
# generate a token with the ads_read permission.
META_ACCESS_TOKEN=
# Optional: your Business Manager ID. When set, the sync pulls both owned and
# client ad accounts from the business. When empty, it uses /me/adaccounts.
META_BUSINESS_ID=
META_API_VERSION=v24.0

# Meta restates conversions for days after a click/view, so every sync re-pulls
# this many trailing days to keep ROAS accurate.
SYNC_LOOKBACK_DAYS=28

# --- App ---
# Protects the dashboard with HTTP basic auth (any username, this password).
# Leave empty only for local development.
APP_PASSWORD=
DATABASE_PATH=./data/tracker.db
